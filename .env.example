# Environment variables

# REQUIRED — JWT signing secret. Generate a strong random string (e.g., 64+ chars).
# In production, use a secure secrets manager.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Allowed origin for CORS. Use a comma-separated list in production.
# Examples:
#   http://localhost:4000
#   https://example.com
#   https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:4000

# Node environment. Options: development, production, test
NODE_ENV=development

# Database file path (SQLite). Defaults to ./data/app.db in project root.
# For Postgres/Neon later: set DATABASE_URL and point SharedUserRepository
# at the Postgres adapter (migrations in server/infrastructure/db are portable).
# DB_PATH=/var/data/myapp/app.db

# Public base URL used to build email links (verify / reset / invite).
APP_URL=http://localhost:40001

# Session lifetimes: short access JWT + long rotated refresh token.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Observability: JSON log level (debug|info|warn|error).
LOG_LEVEL=info
# Optional 5xx webhook (Slack/PagerDuty/ingest endpoint).
# ERROR_WEBHOOK_URL=

# Email: LogMailer (data/outbox/) is the default. For real delivery, add a
# provider client against the Mailer port (see server/infrastructure/mailer.ts).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@example.com

# Billing (Stripe): webhook secret + price ids. Only the webhook handler
# writes subscriptions; enforcement reads via requirePlan middleware.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
